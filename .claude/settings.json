{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lint.mjs --hook",
            "timeout": 20,
            "statusMessage": "communication-pipeline lint"
          }
        ]
      }
    ]
  }
}
